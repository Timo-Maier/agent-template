{
  "name": "btp-nodejs-agent-template",
  "version": "1.0.0",
  "description": "A2A-compatible AI agent template for SAP BTP — Node.js, AI Core, XSUAA, MCP",
  "main": "src/core/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js | pino-pretty",
    "build": "sh scripts/build-srv.sh",
    "bind-services": "sh scripts/bind-services.sh",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "chat": "node scripts/chat-ui.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.14",
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/mcp-adapters": "^1.1.3",
    "@sap-ai-sdk/langchain": "^2.12.0",
    "@sap-ai-sdk/orchestration": "^2.12.0",
    "@sap-cloud-sdk/connectivity": "^4.7.0",
    "@sap/xsenv": "^5.6.1",
    "@sap/xssec": "^4.13.1",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "lru-cache": "^11.5.2",
    "passport": "^0.7.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.5",
    "proxyquire": "^2.1.3",
    "supertest": "^7.2.2",
    "vitest": "^3.2.7"
  }
}
